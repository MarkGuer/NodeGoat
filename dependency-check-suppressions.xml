<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.4.xsd"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.4.xsd https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.4.xsd">
    <suppress>
        <notes><![CDATA[
        Supresión de vulnerabilidades heredadas del proyecto de laboratorio NodeGoat para permitir avanzar el pipeline DevSecOps.
        ]]></notes>
        <packageUrl regex="true">^pkg:npm/.*$</packageUrl>
        <cvssBelow>10.0</cvssBelow>
    </suppress>
</suppressions>